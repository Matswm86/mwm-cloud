    <!-- Hjelp -->
    <string name="help_title">Hvor er filene mine?</string>
    <string name="help_where_title">På din egen lagringsplass</string>
    <string name="help_where_body">Bildene ligger i Bilder, musikken i Musikk, filmene i Video, og det du har valgt selv i Valgt. Innenfor hver av dem er filene sortert på år og måned.</string>
    <string name="help_phone_title">Telefonen røres ikke</string>
    <string name="help_phone_body">Appen kopierer. Den sletter aldri noe fra telefonen, uansett hva du gjør her. Vil du frigjøre plass, gjør du det selv, etterpå, når du har sett at filene er der.</string>
    <string name="help_computer_title">Fra en datamaskin</string>
    <string name="help_computer_body">Du kan også nå filene fra en datamaskin på adressen %1$s, med samme brukernavn og passord som du satte opp her. Det er en nødløsning: alt du trenger til daglig ligger under «Filene dine».</string>
    <string name="help_computer_body_unknown">Når tilkoblingen er satt opp, kan du også nå filene fra en datamaskin med samme brukernavn og passord.</string>
    <string name="help_wifi_title">Bare på trådløst nett</string>
    <string name="help_wifi_body">Sikringen går bare når telefonen er på trådløst nett og har nok batteri. Mobildata blir aldri brukt.</string>
    <string name="help_limits_title">Det appen ikke gjør ennå</string>
    <string name="help_limits_body">Filer over 5 GB blir hoppet over, og du får vite hvilke. Appen sletter heller aldri noe på lagringsplassen.</string>

